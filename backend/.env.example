# 数据库配置（默认即可）
DATABASE_URL=sqlite:///./app.db

# CORS配置（允许的前端地址；生产部署改为实际域名，如 https://sltp.example.com，
# 开发默认 http://localhost:5175 已含；生产前后端同域（nginx反代）时可用 ["*"] 之外的精确域名）
CORS_ORIGINS=["http://localhost:5175","http://127.0.0.1:5175","http://localhost:8000"]

# JWT 密钥（正式部署必配！不配则每次重启所有登录失效；生成：openssl rand -hex 32）
JWT_SECRET=

# ============================================
# 大模型配置（必填）- OpenAI兼容接口
# ============================================

# API密钥（从各大模型平台获取）
LLM_API_KEY=你的API密钥

# API地址（选择其中一种）：
# DeepSeek: https://api.deepseek.com
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱AI: https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型名称（选择其中一种）：
# DeepSeek: deepseek-chat
# 通义千问: qwen-plus / qwen-max
# 智谱AI: glm-4-flash / glm-4-plus
LLM_MODEL=glm-4-flash

# ============================================
# 高德地图API（地址搜索功能需要）
# ============================================
# 申请地址：https://lbs.amap.com/ → 控制台 → 应用管理 → 创建应用 → 添加Key（Web服务）
AMAP_KEY=你的高德地图API密钥
